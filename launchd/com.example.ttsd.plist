<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Run ttsd at login. Replace /PATH/TO/qwen3-tts-console and YOUR_NAME, copy to
     ~/Library/LaunchAgents/, then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.ttsd.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.ttsd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/qwen3-tts-console/.venv/bin/python</string>
    <string>/PATH/TO/qwen3-tts-console/ttsd.py</string>
  </array>
  <key>WorkingDirectory</key><string>/PATH/TO/qwen3-tts-console</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/YOUR_NAME/Library/Logs/ttsd.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_NAME/Library/Logs/ttsd.log</string>
</dict>
</plist>
